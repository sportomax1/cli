# ─── Required ───────────────────────────────────────────────
# Your Google Gemini API key.
# Get one at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Password that gates access to the web UI.
# Pick something strong — this is your only access control.
APP_PASSWORD=change_me_to_something_strong

# ─── Optional ───────────────────────────────────────────────
# Override the default model (must be a valid Gemini model ID).
# See the /api/model endpoint for available models.
# DEFAULT_MODEL=gemini-2.0-flash

# Optional system-level instruction injected into every chat session.
# DEFAULT_SYSTEM_PROMPT=You are a concise and helpful assistant.
